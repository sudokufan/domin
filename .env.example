# Copy this file to `.env` (or `.env.local`) to point the app at a real REST API.
#
# Leave it unset / empty to use the built-in mock data (src/api/mockData.ts) —
# that's the default and needs no .env file at all.
#
# Set it to your backend's base URL to switch every endpoint to live HTTPS/JSON:
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
